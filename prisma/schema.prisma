generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id               String             @id @default(uuid())
  naam             String
  werfadres        String
  bouwheer         String?
  bouwheerBedrijf  String?            @map("bouwheer_bedrijf")
  bouwheerAdres    String?            @map("bouwheer_adres")
  bouwheerEmail    String?            @map("bouwheer_email")
  bouwheerTelefoon String?            @map("bouwheer_telefoon")
  startdatum       DateTime?          @db.Date @map("startdatum")
  beschrijving     String?
  aangemaaktOp     DateTime           @default(now()) @map("aangemaakt_op")
  deelnemers       ProjectDeelnemer[]
  werfverslagen    Werfverslag[]
  opmerkingen      Opmerking[]

  @@map("project")
}

model ProjectDeelnemer {
  id                 String                 @id @default(uuid())
  projectId          String                 @map("project_id")
  project            Project                @relation(fields: [projectId], references: [id])
  adresboekContactId String?                @map("adresboek_contact_id")
  adresboekContact   AdresboekContact?      @relation(fields: [adresboekContactId], references: [id])
  naam               String
  discipline         String
  email              String
  aanwezigheden      WerfverslagAanwezige[]

  @@map("project_deelnemer")
}

model AdresboekContact {
  id           String             @id @default(uuid())
  naam         String
  bedrijf      String?
  adres        String?
  discipline   String
  email        String             @unique
  telefoon     String?
  aangemaaktOp DateTime           @default(now()) @map("aangemaakt_op")
  deelnemers   ProjectDeelnemer[]

  @@map("adresboek_contact")
}

model Werfverslag {
  id              String                 @id @default(uuid())
  projectId       String                 @map("project_id")
  project         Project                @relation(fields: [projectId], references: [id])
  verslaggever    String
  datum           DateTime               @db.Date
  aangemaaktOp    DateTime               @default(now()) @map("aangemaakt_op")
  nokPunten       NokPunt[]
  aanwezigen      WerfverslagAanwezige[]
  magicLinkTokens MagicLinkToken[]
  opmerkingen     Opmerking[]

  @@map("werfverslag")
}

model WerfverslagAanwezige {
  id                 String           @id @default(uuid())
  werfverslagId      String           @map("werfverslag_id")
  werfverslag        Werfverslag      @relation(fields: [werfverslagId], references: [id])
  projectDeelnemerId String           @map("project_deelnemer_id")
  projectDeelnemer   ProjectDeelnemer @relation(fields: [projectDeelnemerId], references: [id])

  @@map("werfverslag_aanwezige")
}

model NokPunt {
  id                      String           @id @default(uuid())
  werfverslagId           String           @map("werfverslag_id")
  werfverslag             Werfverslag      @relation(fields: [werfverslagId], references: [id])
  titel                   String
  discipline              String
  omschrijving            String?
  fotoUrls                String[]         @default([]) @map("foto_urls")
  verantwoordelijkeNaam   String           @map("verantwoordelijke_naam")
  verantwoordelijkeEmail  String           @map("verantwoordelijke_email")
  deadline                DateTime         @db.Date
  status                  String           @default("open")
  opgelostDoorNaam        String?          @map("opgelost_door_naam")
  opgelostOp              DateTime?        @map("opgelost_op")
  oplossingOmschrijving   String?          @map("oplossing_omschrijving")
  oplossingFotoUrl        String?          @map("oplossing_foto_url")
  afkeuringsReden         String?          @map("afkeurings_reden")
  afgekeurdOp             DateTime?        @map("afgekeurd_op")
  aangemaaktOp            DateTime         @default(now()) @map("aangemaakt_op")
  opmerkingen             Opmerking[]

  @@map("nok_punt")
}

model Opmerking {
  id            String       @id @default(uuid())
  projectId     String?      @map("project_id")
  project       Project?     @relation(fields: [projectId], references: [id])
  werfverslagId String?      @map("werfverslag_id")
  werfverslag   Werfverslag? @relation(fields: [werfverslagId], references: [id])
  nokPuntId     String?      @map("nok_punt_id")
  nokPunt       NokPunt?     @relation(fields: [nokPuntId], references: [id])
  auteurNaam    String       @map("auteur_naam")
  auteurRol     String       @map("auteur_rol")
  tekst         String
  fotoUrls      String[]     @default([]) @map("foto_urls")
  aangemaaktOp  DateTime     @default(now()) @map("aangemaakt_op")

  @@map("opmerking")
}

model MagicLinkToken {
  id                     String      @id @default(uuid())
  token                  String      @unique
  werfverslagId          String      @map("werfverslag_id")
  werfverslag            Werfverslag @relation(fields: [werfverslagId], references: [id])
  verantwoordelijkeEmail String      @map("verantwoordelijke_email")
  verantwoordelijkeNaam  String      @map("verantwoordelijke_naam")
  vervalOp               DateTime    @map("vervalt_op")
  aangemaaktOp           DateTime    @default(now()) @map("aangemaakt_op")

  @@map("magic_link_token")
}
